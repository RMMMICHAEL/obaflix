{
  "name": "streaming-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test:extractors": "node --test \"desktop/electron/__tests__/*.test.js\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "import": "tsx scripts/import.ts",
    "sync": "tsx scripts/sync-megaflix.ts",
    "sync-app": "tsx scripts/sync-app.ts",
    "sync-superflix": "tsx scripts/sync-superflix.ts",
    "sync-superflix:backfill": "tsx scripts/sync-superflix.ts --backfill",
    "sync:local": "tsx scripts/run-local-syncs.ts",
    "sync:local:check": "tsx scripts/run-local-syncs.ts --check",
    "test:cinevs": "tsx scripts/test-cinevs.ts",
    "test:web": "node --test --import tsx \"src/lib/__tests__/*.test.ts\"",
    "test": "npm run test:extractors && npm run test:web",
    "test:webcine": "tsx scripts/testar-webcine-sessoes.ts"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
