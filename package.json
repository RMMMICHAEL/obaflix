    "@types/hls.js": "^1.0.0",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "hls.js": "^1.6.16",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.21.0",
    "next": "14.2.35",
    "next-auth": "4.24.15",
    "react": "^18",
    "react-dom": "^18",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "8.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
