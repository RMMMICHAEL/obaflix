generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Filme {
  id               String        @id
  tmdbId           String?
  imdbId           String?
  titulo           String
  tituloOriginal   String?
  poster           String?
  background       String?
  logo             String?
  sinopse          String?       @db.Text
  ano              Int?
  nota             Float?
  voteCount        Int?
  popularidade     Float?
  scoreDestaque    Float?
  duracao          Int?
  top250           Int?
  top250Fonte          String?
  top250AtualizadoEm   DateTime?
  popularRank          Int?
  popularRankPrev      Int?
  popularCheckedAt     DateTime?
  // Quando a arte (backdrop/logo) foi consultada no TMDB pela ultima vez.
  // Coluna propria de proposito: usar `logo: null` como substituto fazia o
  // backfill parar de revisitar quem ja tinha logo, mesmo com background
  // errado, e `updatedAt` muda por qualquer escrita.
  artCheckedAt         DateTime?
  sagaId           Int?
  originalLanguage String?
  urlDub           String?       @db.Text
  urlLeg           String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  generos          FilmeGenero[]
  progresso        WatchHistory[]
  watchlist        Watchlist[]

  // O backfill varre "ainda nao verificado" na ordem de popularidade.
  @@index([artCheckedAt, popularidade])
}

model Serie {
  id             String        @id
  tmdbId         String?
  imdbId         String?
  titulo         String
  tituloOriginal String?
  poster         String?
  background     String?
  logo           String?
  sinopse        String?       @db.Text
  ano            Int?
  nota           Float?
  voteCount        Int?
  popularidade     Float?
  scoreDestaque    Float?
  temporadas     Int?
  top250           Int?
  top250Fonte          String?
  top250AtualizadoEm   DateTime?
  popularRank          Int?
  popularRankPrev      Int?
  popularCheckedAt     DateTime?
  artCheckedAt         DateTime?
  tipo             String        @default("serie")
  originalLanguage String?
  createdAt        DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  episodios      Episodio[]
  generos        SerieGenero[]
  progresso      WatchHistory[]
  watchlist      Watchlist[]

  @@index([artCheckedAt, popularidade])
}

model Episodio {
  id        String        @id
  serieId   String
  serie     Serie         @relation(fields: [serieId], references: [id])
  numeroEp  Int
  temporada Int
  titulo    String?
  thumbnail String?
  urlDub    String?       @db.Text
  urlLeg    String?       @db.Text
  createdAt DateTime      @default(now())
  progresso WatchHistory[]

  @@unique([serieId, temporada, numeroEp])

  // "Novos episodios" ordena 358 mil linhas por createdAt. Sem indice a
  // query levava ~2,6s de trabalho de banco e segurava a /android inteira.
  @@index([createdAt(sort: Desc)])
  // Deduplicacao da vitrine: encontra o episodio atual de cada serie sem
  // revarrer a tabela inteira para cada card.
  @@index([serieId, temporada(sort: Desc), numeroEp(sort: Desc), createdAt(sort: Desc)], map: "Episodio_vitrine_recente_idx")
}

model Genero {
  id     Int           @id
  nome   String
  filmes FilmeGenero[]
  series SerieGenero[]
}

model FilmeGenero {
  filmeId  String
  generoId Int
  filme    Filme  @relation(fields: [filmeId], references: [id])
  genero   Genero @relation(fields: [generoId], references: [id])
  @@id([filmeId, generoId])
}

model SerieGenero {
  serieId  String
  generoId Int
  serie    Serie  @relation(fields: [serieId], references: [id])
  genero   Genero @relation(fields: [generoId], references: [id])
  @@id([serieId, generoId])
}

model User {
  id           String         @id @default(cuid())
  nome         String?
  email        String         @unique
  senhaHash    String?
  avatar       String?
  role         String         @default("user")
  createdAt    DateTime       @default(now())
  historico    WatchHistory[]
  watchlist    Watchlist[]
  likes        Like[]
  dispositivos TvDevice[]
  /// Relação virtual: não cria coluna em User. O histórico fica aqui inteiro —
  /// renovações e planos anteriores — e "tem assinatura ativa?" é sempre uma
  /// consulta por status e datas, nunca um campo guardado nesta linha.
  assinaturas  Assinatura[]
}

/// Um aparelho de TV pareado.
///
/// O pareamento em si vive no Redis com TTL curto — aqui só chega o que precisa
/// sobreviver: qual aparelho é, de quem, e se ainda vale. Uma linha por TV.
model TvDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// O que o usuário lê na lista de dispositivos. Nunca um identificador.
  nome   String
  modelo String?

  /// SHA-256 de androidId + modelo. Guardamos o hash, não o identificador do
  /// aparelho: serve para reconhecer o mesmo aparelho, e não para rastreá-lo
  /// fora daqui. É o que amarra o poll e o refresh ao aparelho que iniciou.
  fingerprint String

  criadoEm  DateTime  @default(now())
  ultimoUso DateTime  @default(now())
  /// Só o /24 do IPv4 (ou /48 do IPv6) — o suficiente para o usuário reconhecer
  /// "minha casa" sem guardar o endereço inteiro de ninguém.
  ultimaRede String?
  revogadoEm DateTime?

  tokens TvRefreshToken[]

  /// Reparear a mesma TV atualiza a linha em vez de criar outra.
  @@unique([userId, fingerprint])
  @@index([userId])
}

/// Refresh token de um aparelho.
///
/// Opaco, nunca um JWT: precisa ser revogável de imediato, e um JWT continuaria
/// válido até expirar. O banco guarda só o SHA-256 — vazamento de backup não
/// entrega credencial utilizável.
///
/// `familia` é o que detecta roubo: cada rotação cria um token novo na mesma
/// família. Se um token já usado reaparecer, a família inteira é revogada,
/// porque ou o ladrão ou o dono legítimo está usando uma cópia.
model TvRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  deviceId  String
  device    TvDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  familia   String
  criadoEm  DateTime @default(now())
  expiraEm  DateTime
  usadoEm   DateTime?
  revogadoEm DateTime?

  @@index([deviceId])
  @@index([familia])
}

model Like {
  id           String   @id @default(cuid())
  userId       String
  conteudoId   String
  conteudoTipo String
  valor        Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conteudoId, conteudoTipo])
}

model WatchHistory {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  conteudoId   String
  conteudoTipo String
  episodioId   String?
  episodio     Episodio? @relation(fields: [episodioId], references: [id])
  temporada    Int?
  numeroEp     Int?
  progressoSeg Int       @default(0)
  duracaoSeg   Int?
  concluido    Boolean   @default(false)
  queued       Boolean   @default(false)
  updatedAt    DateTime  @updatedAt
  filmeId      String?
  filme        Filme?    @relation(fields: [filmeId], references: [id])
  serieId      String?
  serie        Serie?    @relation(fields: [serieId], references: [id])
  @@unique([userId, conteudoId, episodioId])
}

model Watchlist {
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  conteudoId   String
  conteudoTipo String
  addedAt      DateTime @default(now())
  filmeId      String?
  filme        Filme?   @relation(fields: [filmeId], references: [id])
  serieId      String?
  serie        Serie?   @relation(fields: [serieId], references: [id])
  @@id([userId, conteudoId, conteudoTipo])
}

model Saga {
  id   Int    @id
  nome String
}

model PopularHistory {
  id           String   @id @default(cuid())
  conteudoId   String
  conteudoTipo String   // "filme" | "serie"
  rank         Int
  recordedAt   DateTime @default(now())

  @@index([conteudoId, conteudoTipo])
}

model SyncMetric {
  id               String   @id @default(cuid())
  job              String   // "popular-sync"
  source           String   // "tmdb"
  startedAt        DateTime @default(now())
  durationMs       Int
  found            Int
  added            Int
  removed          Int
  repositioned     Int
  bytesTransferred Int?
  errors           Int
  ok               Boolean
  errorMessage     String?  @db.Text
  detail           String?  @db.Text
}

// ─────────────────────────────────────────────────────────────────────────────
// Planos, preços e assinatura
//
// Fase 1 da camada de monetização: só as tabelas e o plano padrão. Nenhuma rota
// lê estes modelos ainda, e nenhuma linha de Assinatura é criada — a migration
// não muda o comportamento de nenhum usuário.
//
// Regra que atravessa os três modelos: **o nome do plano nunca decide nada**.
// Quem decide é cada direito, explicitamente, coluna a coluna. É o que permite
// mudar plano comercialmente sem publicar aplicativo novo.
//
// Campos de domínio fechado são `String` com CHECK, e não `enum` nativo. As
// razões, na ordem em que pesaram:
//
//   - evoluir um nível (acrescentar, renomear, restringir) fica dentro de uma
//     migration SQL comum, que é como este projeto já escreve migration;
//   - `conteudoTipo` e `role` já são assim aqui — um `enum` criaria um segundo
//     estilo para o mesmo tipo de campo;
//   - o CHECK é declarado explicitamente na migration, onde dá para lê-lo;
//   - o Prisma não representa esses CHECK no schema, então a validação vive no
//     banco de qualquer forma.
//
// A contrapartida é que os valores aceitos passam a existir em dois lugares: as
// constantes de `src/lib/planos.ts` e os CHECK da migration.
// `src/lib/__tests__/planos.test.ts` lê os dois arquivos e falha se divergirem.
// ─────────────────────────────────────────────────────────────────────────────

/// Um plano comercial e os direitos que ele concede.
///
/// O plano Gratuito é uma linha como qualquer outra, marcada `ehPadrao`. Quem
/// não tem assinatura ativa resolve para ela. Isso evita o `if (!assinatura)`
/// espalhado por todo lado, e faz "restringir o gratuito" ser a edição de uma
/// linha em vez de um deploy.
model Plano {
  /// Slug estável — "gratuito", "plus". Serve à idempotência do seed, ao
  /// suporte e ao log. **Nunca ramifique lógica por este valor**: quem decide
  /// é o direito abaixo, não a identidade do plano.
  id        String  @id
  nome      String
  descricao String?
  ordem     Int     @default(0)
  ativo     Boolean @default(true)

  /// O plano de quem não tem assinatura ativa. Índice único parcial no SQL
  /// garante no máximo um.
  ehPadrao Boolean @default(false)

  // ── Direitos ──────────────────────────────────────────────────────────────
  // O default de cada campo é o mais restritivo. Um plano criado sem informar
  // um direito não o concede por acidente — só o seed do Gratuito abre tudo, e
  // abre de propósito, para preservar o comportamento de hoje.

  /// Forma positiva de propósito. `remove_ads = false` é dupla negação em todo
  /// `if`, e um campo ausente viraria "sem anúncios" por acidente. Aqui,
  /// ausente ⇒ true ⇒ pede anúncio: falha para o lado seguro.
  anunciosObrigatorios Boolean @default(true)

  /// O `N` da regra de séries — anúncio a cada N episódios distintos. null
  /// quando o plano não exibe anúncio.
  episodiosPorAnuncio Int?

  /// Janela do contador de episódios. Fora dela, o contador recomeça.
  janelaAnuncioHoras Int @default(24)

  /// Default `false` como todo direito aqui: um plano criado sem informar
  /// acesso a catálogo não o concede. Quem libera é sempre uma decisão escrita,
  /// e o seed do Gratuito escreve as duas explicitamente.
  filmes Boolean @default(false)
  series Boolean @default(false)

  /// "nenhum" | "gratuito" | "plus" | "premium" — ordenado, não booleano.
  /// Dois booleanos (has_iptv_plus + has_iptv_premium) permitem o estado
  /// impossível "os dois verdadeiros" e obrigam cada cliente a inventar a
  /// precedência. Um nível não permite.
  ///
  /// Direito separado de `anunciosObrigatorios` de propósito: um plano pode
  /// ser sem anúncios e não incluir canais.
  canaisNivel String @default("nenhum")

  downloads Boolean @default(false)

  /// Telas simultâneas. Hoje o limite é a constante MAX_CONCURRENT em
  /// src/lib/playTokens.ts; quando a autorização for ligada, é este campo que
  /// a substitui.
  telasMax Int @default(1)

  /// Reservado. Perfis não existem no schema — são projeto próprio, porque
  /// tocam histórico, watchlist e continuar assistindo.
  perfisMax Int @default(1)

  /// "sd" | "hd" | "fhd" | "4k"
  resolucaoMax String @default("hd")

  /// "nenhum" | "limitado" | "completo"
  tvNivel String @default("limitado")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  precos      PlanoPreco[]
  assinaturas Assinatura[]

  @@index([ativo, ordem])
}

/// Uma duração comprável de um plano.
///
/// O plano Gratuito nasce sem nenhuma linha aqui: ele não é comprável, e isso
/// fica modelado em vez de virar um caso especial no código.
model PlanoPreco {
  id      String @id @default(cuid())
  planoId String
  plano   Plano  @relation(fields: [planoId], references: [id], onDelete: Cascade)

  /// O que o usuário lê: "Mensal", "6 meses", "Anual".
  rotulo      String
  duracaoDias Int

  /// **Centavos, inteiro, sempre.** Nunca float — 8.90 não existe em binário e
  /// o erro aparece na conferência do webhook, que compara o valor pago com o
  /// esperado. Nunca string, que é como o modelo de referência fazia.
  precoCentavos Int

  /// Valor riscado na vitrine. null quando não há promoção.
  precoOriginalCentavos Int?

  moeda String  @default("BRL")
  ativo Boolean @default(true)
  ordem Int     @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  assinaturas Assinatura[]

  @@index([planoId, ativo, ordem])
}

/// A assinatura de uma conta.
///
/// Não existe coluna "é premium", nem cache de direito. Assinatura ativa é
/// sempre derivada: `status = 'ATIVA' AND iniciaEm <= now() < terminaEm`.
/// Guardar o direito na linha significaria mantê-lo em sincronia com o
/// vencimento, e é exatamente aí que sistemas assim erram.
///
/// A assinatura pertence à **conta**, não ao perfil.
model Assinatura {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  planoId String
  plano   Plano  @relation(fields: [planoId], references: [id])

  /// Qual duração foi comprada. null para origem que não passou por preço
  /// (cortesia, migração). SET NULL no banco: apagar um preço encerrado não
  /// pode apagar a assinatura de ninguém.
  planoPrecoId String?
  planoPreco   PlanoPreco? @relation(fields: [planoPrecoId], references: [id], onDelete: SetNull)

  /// "ATIVA" | "EXPIRADA" | "CANCELADA" | "SUSPENSA"
  status String

  iniciaEm  DateTime
  terminaEm DateTime

  /// "pagamento" | "cortesia" | "migracao" | "admin" — de onde veio o direito.
  /// É o que responde "por que esta conta tem plano?" numa auditoria.
  origem String @default("pagamento")

  /// Trava de idempotência do pagamento: um pedido ativa no máximo uma
  /// assinatura, garantido pelo banco e não por `if` em código.
  ///
  /// Único já nesta fase, e de propósito: criar índice único depois, sobre
  /// tabela povoada, é migration com risco. Agora a tabela está vazia e custa
  /// zero. A chave estrangeira para PedidoPagamento entra com aquela tabela —
  /// aqui a coluna ainda não referencia nada.
  pedidoId String? @unique

  /// Anotação de suporte. Nunca dado de pagamento, nunca documento.
  observacao String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// "esta conta tem assinatura ativa?" — a consulta do caminho quente.
  @@index([userId, status, terminaEm])
  /// varredura de vencimento, sem varrer a tabela inteira.
  @@index([status, terminaEm])
}
