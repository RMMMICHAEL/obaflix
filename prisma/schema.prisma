generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Filme {
  id               String        @id
  tmdbId           String?
  imdbId           String?
  titulo           String
  tituloOriginal   String?
  poster           String?
  background       String?
  logo             String?
  sinopse          String?       @db.Text
  ano              Int?
  nota             Float?
  voteCount        Int?
  popularidade     Float?
  scoreDestaque    Float?
  duracao          Int?
  top250           Int?
  top250Fonte          String?
  top250AtualizadoEm   DateTime?
  popularRank          Int?
  popularRankPrev      Int?
  popularCheckedAt     DateTime?
  // Quando a arte (backdrop/logo) foi consultada no TMDB pela ultima vez.
  // Coluna propria de proposito: usar `logo: null` como substituto fazia o
  // backfill parar de revisitar quem ja tinha logo, mesmo com background
  // errado, e `updatedAt` muda por qualquer escrita.
  artCheckedAt         DateTime?
  sagaId           Int?
  originalLanguage String?
  urlDub           String?       @db.Text
  urlLeg           String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  generos          FilmeGenero[]
  progresso        WatchHistory[]
  watchlist        Watchlist[]

  // O backfill varre "ainda nao verificado" na ordem de popularidade.
  @@index([artCheckedAt, popularidade])
}

model Serie {
  id             String        @id
  tmdbId         String?
  imdbId         String?
  titulo         String
  tituloOriginal String?
  poster         String?
  background     String?
  logo           String?
  sinopse        String?       @db.Text
  ano            Int?
  nota           Float?
  voteCount        Int?
  popularidade     Float?
  scoreDestaque    Float?
  temporadas     Int?
  top250           Int?
  top250Fonte          String?
  top250AtualizadoEm   DateTime?
  popularRank          Int?
  popularRankPrev      Int?
  popularCheckedAt     DateTime?
  artCheckedAt         DateTime?
  tipo             String        @default("serie")
  originalLanguage String?
  createdAt        DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  episodios      Episodio[]
  generos        SerieGenero[]
  progresso      WatchHistory[]
  watchlist      Watchlist[]

  @@index([artCheckedAt, popularidade])
}

model Episodio {
  id        String        @id
  serieId   String
  serie     Serie         @relation(fields: [serieId], references: [id])
  numeroEp  Int
  temporada Int
  titulo    String?
  thumbnail String?
  urlDub    String?       @db.Text
  urlLeg    String?       @db.Text
  createdAt DateTime      @default(now())
  progresso WatchHistory[]

  @@unique([serieId, temporada, numeroEp])

  // "Novos episodios" ordena 358 mil linhas por createdAt. Sem indice a
  // query levava ~2,6s de trabalho de banco e segurava a /android inteira.
  @@index([createdAt(sort: Desc)])
}

model Genero {
  id     Int           @id
  nome   String
  filmes FilmeGenero[]
  series SerieGenero[]
}

model FilmeGenero {
  filmeId  String
  generoId Int
  filme    Filme  @relation(fields: [filmeId], references: [id])
  genero   Genero @relation(fields: [generoId], references: [id])
  @@id([filmeId, generoId])
}

model SerieGenero {
  serieId  String
  generoId Int
  serie    Serie  @relation(fields: [serieId], references: [id])
  genero   Genero @relation(fields: [generoId], references: [id])
  @@id([serieId, generoId])
}

model User {
  id           String         @id @default(cuid())
  nome         String?
  email        String         @unique
  senhaHash    String?
  avatar       String?
  role         String         @default("user")
  createdAt    DateTime       @default(now())
  historico    WatchHistory[]
  watchlist    Watchlist[]
  likes        Like[]
  dispositivos TvDevice[]
}

/// Um aparelho de TV pareado.
///
/// O pareamento em si vive no Redis com TTL curto — aqui só chega o que precisa
/// sobreviver: qual aparelho é, de quem, e se ainda vale. Uma linha por TV.
model TvDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// O que o usuário lê na lista de dispositivos. Nunca um identificador.
  nome   String
  modelo String?

  /// SHA-256 de androidId + modelo. Guardamos o hash, não o identificador do
  /// aparelho: serve para reconhecer o mesmo aparelho, e não para rastreá-lo
  /// fora daqui. É o que amarra o poll e o refresh ao aparelho que iniciou.
  fingerprint String

  criadoEm  DateTime  @default(now())
  ultimoUso DateTime  @default(now())
  /// Só o /24 do IPv4 (ou /48 do IPv6) — o suficiente para o usuário reconhecer
  /// "minha casa" sem guardar o endereço inteiro de ninguém.
  ultimaRede String?
  revogadoEm DateTime?

  tokens TvRefreshToken[]

  /// Reparear a mesma TV atualiza a linha em vez de criar outra.
  @@unique([userId, fingerprint])
  @@index([userId])
}

/// Refresh token de um aparelho.
///
/// Opaco, nunca um JWT: precisa ser revogável de imediato, e um JWT continuaria
/// válido até expirar. O banco guarda só o SHA-256 — vazamento de backup não
/// entrega credencial utilizável.
///
/// `familia` é o que detecta roubo: cada rotação cria um token novo na mesma
/// família. Se um token já usado reaparecer, a família inteira é revogada,
/// porque ou o ladrão ou o dono legítimo está usando uma cópia.
model TvRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  deviceId  String
  device    TvDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  familia   String
  criadoEm  DateTime @default(now())
  expiraEm  DateTime
  usadoEm   DateTime?
  revogadoEm DateTime?

  @@index([deviceId])
  @@index([familia])
}

model Like {
  id           String   @id @default(cuid())
  userId       String
  conteudoId   String
  conteudoTipo String
  valor        Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conteudoId, conteudoTipo])
}

model WatchHistory {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  conteudoId   String
  conteudoTipo String
  episodioId   String?
  episodio     Episodio? @relation(fields: [episodioId], references: [id])
  temporada    Int?
  numeroEp     Int?
  progressoSeg Int       @default(0)
  duracaoSeg   Int?
  concluido    Boolean   @default(false)
  queued       Boolean   @default(false)
  updatedAt    DateTime  @updatedAt
  filmeId      String?
  filme        Filme?    @relation(fields: [filmeId], references: [id])
  serieId      String?
  serie        Serie?    @relation(fields: [serieId], references: [id])
  @@unique([userId, conteudoId, episodioId])
}

model Watchlist {
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  conteudoId   String
  conteudoTipo String
  addedAt      DateTime @default(now())
  filmeId      String?
  filme        Filme?   @relation(fields: [filmeId], references: [id])
  serieId      String?
  serie        Serie?   @relation(fields: [serieId], references: [id])
  @@id([userId, conteudoId, conteudoTipo])
}

model Saga {
  id   Int    @id
  nome String
}

model PopularHistory {
  id           String   @id @default(cuid())
  conteudoId   String
  conteudoTipo String   // "filme" | "serie"
  rank         Int
  recordedAt   DateTime @default(now())

  @@index([conteudoId, conteudoTipo])
}

model SyncMetric {
  id               String   @id @default(cuid())
  job              String   // "popular-sync"
  source           String   // "tmdb"
  startedAt        DateTime @default(now())
  durationMs       Int
  found            Int
  added            Int
  removed          Int
  repositioned     Int
  bytesTransferred Int?
  errors           Int
  ok               Boolean
  errorMessage     String?  @db.Text
  detail           String?  @db.Text
}
