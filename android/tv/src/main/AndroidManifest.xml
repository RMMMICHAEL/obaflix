<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- leanback com required="false" de proposito: muitos TV Box AOSP nao
         declaram o recurso, e com "true" o instalador os recusa. O app continua
         aparecendo no launcher de TV por causa da categoria LEANBACK_LAUNCHER. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- A permissao de INTERNET vem do :core-extractor pelo merge de manifest. -->

    <application
        android:name="com.obaflix.ObaflixApp"
        android:allowBackup="false"
        android:banner="@drawable/banner_tv"
        android:icon="@drawable/ic_launcher_tv"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ObaflixTv"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER coloca o app na tela inicial do Android TV.
                     LAUNCHER cobre o TV Box que roda um launcher de tablet. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
