<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional SDK capabilities are not part of our advertising product. -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Download em segundo plano.

        Nao ha READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE nem
        MANAGE_EXTERNAL_STORAGE, e nao deve haver: a gravacao acontece
        exclusivamente na arvore que o usuario aponta no seletor do sistema
        (ACTION_OPEN_DOCUMENT_TREE), com a concessao persistida por
        takePersistableUriPermission. Nada fora dela e alcancavel pelo app.

        FOREGROUND_SERVICE_DATA_SYNC e obrigatoria a partir do Android 14 para
        o tipo dataSync declarado no servico; POST_NOTIFICATIONS e pedida em
        tempo de execucao a partir do Android 13 e recusa-la nao impede o
        download, so esconde o progresso.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Visibilidade de pacote (Android 11+): sem isto, packageManager nao
        enxerga o Web Video Cast e o app sempre concluiria que ele nao esta
        instalado. Declara so o pacote de destino e a loja — nao e uma consulta
        aberta ao que o usuario tem instalado.
    -->
    <queries>
        <package android:name="com.instantbits.cast.webvideo" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application
        android:name=".ObaflixApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Obaflix"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${admobAppId}" />
        <!-- SDK-supported opt-out: MyTargetContentProvider otherwise calls initSdk at startup. -->
        <meta-data android:name="com.my.target.autoInitMode" android:value="0" />
        <!-- Unity initialization is delegated to LevelPlay AFTER consent. -->
        <provider android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup" tools:node="merge">
            <meta-data android:name="com.unity3d.services.core.configuration.AdsSdkInitializer" tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            exported="false": o servico so e acionado pelo proprio app, por
            Intent explicito. Exportado, qualquer aplicativo poderia enfileirar
            ou cancelar downloads alheios.
        -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
