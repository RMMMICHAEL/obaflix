DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Exigida pelo schema (datasource.directUrl). Em pooler (PgBouncer/Supabase)
# aponte para a conexão direta; sem pooler, repita o valor de DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
NEXTAUTH_SECRET="gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://www.seu-dominio.com"
GOOGLE_SITE_VERIFICATION=""
# Ative somente para catálogo cuja publicação e indexação estejam autorizadas.
CONTENT_INDEXING_ENABLED="false"
# Padrão: segmentos de vídeo vão diretamente do CDN ao usuário, economizando
# Fast Origin Transfer. Use "proxy" apenas como fallback temporário para fontes
# incompatíveis com CORS.
MEDIA_SEGMENT_DELIVERY="direct"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TMDB_API_KEY=""
# LEGADO, em descontinuação. Só autoriza GET/POST em /api/admin/{filme,serie,
# episodio/bulk} no projeto público com o cutover desligado (Tampermonkey e
# sync-app antigos). Nunca abre API humana. Mínimo 32 caracteres; remova do
# deploy para desligar o legado antes do cutover. Destino: CATALOG_SYNC_TOKEN.
ADMIN_SECRET_TOKEN=
CRON_SECRET="gere-um-segredo-forte-para-os-crons"

# Redis distribuído (recomendado para produção multi-instância no Vercel)
# Obtenha em https://console.upstash.com — plano free suporta 10k req/dia
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Monetização e cobrança: permanecem desligadas até configuração comercial.
MONETIZACAO_ATIVA="false"
BLACKCAT_PIX_ATIVO="false"
BLACKCAT_CONFIRMACAO_ATIVA="false"
BLACKCAT_API_KEY=""
BLACKCAT_WEBHOOK_PATH_SECRET=""
ANUNCIO_DIRECT_LINK_URL=""

# Legado (não usado em produção Vercel — mantido para referência)
REDIS_URL=""

# Webcine player (webcinevs2.com) — renova a cada ~30 dias via POST /api/auth/refresh
WEBCINE_REFRESH_TOKEN=""
WEBCINE_DEVICE_ID=""
WEBCINE_PROFILE_ID=""

# Hosts autorizados como iframe de fallback no player (sem esquema, separados por
# vírgula). O CSP com esta lista só é emitido em /assistir/* e /player/*; todas as
# outras rotas recebem frame-src 'none'. Vazio = usa o padrão de next.config.mjs.
PLAYER_FRAME_HOSTS=

# Liga o diagnóstico do ciclo de vida das fontes ([fontes/*] nos logs do servidor):
# criação, resolução, TTL restante e motivo de falha. Em desenvolvimento já vem
# ligado. Nunca imprime URL, token ou sessão inteira.
PLAYER_DIAG=

# ── Landing pública / fechamento temporário do streaming web ────────────────
# "true" reabre o site de streaming para navegador comum. Qualquer outro valor
# (ou ausente) mantém `/` como landing de download e manda o navegador de volta
# para ela nas páginas de catálogo.
#
# Não afeta os aplicativos em nenhum dos dois estados: Android entra por
# /android e Electron por /desktop, e quem abrir `/` com o User-Agent oficial é
# reescrito internamente para a entrada certa. Também não afeta /api/*,
# /parear, /login, /cadastro nem /admin.
WEB_STREAMING_ENABLED=false

# URLs dos instaladores (Cloudflare R2 → app.obaflix.online). OPCIONAIS: o link
# publicado hoje já é o padrão em src/config/downloads.ts, e estas variáveis só
# existem para trocar de versão sem deploy. Nada é hospedado na Vercel.
NEXT_PUBLIC_DOWNLOAD_ANDROID=
NEXT_PUBLIC_DOWNLOAD_ANDROID_VERSAO=
NEXT_PUBLIC_DOWNLOAD_ANDROID_TAMANHO=
NEXT_PUBLIC_DOWNLOAD_ANDROID_TV=
NEXT_PUBLIC_DOWNLOAD_ANDROID_TV_VERSAO=
NEXT_PUBLIC_DOWNLOAD_ANDROID_TV_TAMANHO=
NEXT_PUBLIC_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DOWNLOAD_WINDOWS_VERSAO=
NEXT_PUBLIC_DOWNLOAD_WINDOWS_TAMANHO=
# ── Superfície e cutover do admin ───────────────────────────────────────────
# Superfície do deploy. Configure as DUAS em cada projeto Vercel: a NEXT_PUBLIC
# é compilada na tela de login. "admin" só no projeto do painel.
OBAFLIX_SURFACE=public
NEXT_PUBLIC_OBAFLIX_SURFACE=public
# Cutover do admin público: "1"/"true" faz /admin, /admin/* e /api/admin/*
# responderem 404 no projeto PÚBLICO. Qualquer outro valor ou ausente =
# desligado. Só ligue depois de migrar os produtores para a integração.
# (OBAFLIX_PUBLIC_ADMIN_CUTOVER, nome da fase 1, continua aceito; este vence.)
PUBLIC_CUTOVER_ATIVO=0

# Ingestão de catálogo máquina→máquina (/api/integracoes/catalogo/*). Valor
# aleatório com 32+ caracteres (ex.: openssl rand -base64 48). Nunca autoriza
# /api/admin, usuários, senhas, assinaturas, pagamentos nem auditoria.
CATALOG_SYNC_TOKEN=

# Produtores HTTP (scripts/sync-app.ts): ausente = integração quando houver
# CATALOG_SYNC_TOKEN, senão legado com aviso. "legado" | "integracao" força.
# OBAFLIX_SYNC_DESTINO=
# OBAFLIX_URL=https://seu-projeto-publico.example
